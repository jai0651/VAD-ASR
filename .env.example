# Copy to `.env` and fill in what you use. `.env` is git-ignored; this file is
# the committed template. Any VOICE_* setting from src/pipeline/config.py can
# also be set here (e.g. VOICE_ASR_ENGINE=whisper).

# --- LLM responder: OpenAI (VOICE_RESPONDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- LLM responder: Claude (VOICE_RESPONDER=claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GPU training on RunPod (the runpod-train skill) ---
# runpod.io -> Settings -> API Keys. The skill reads this from .env.
RUNPOD_API_KEY=rpa_...

# --- pipeline engine selection (optional; defaults are the scratch models) ---
# VOICE_RESPONDER=openai
# VOICE_VAD_ENGINE=silero
# VOICE_ASR_ENGINE=whisper
# Module 6 Conformer (scripts/11). CHUNK=0 offline, 16 = 640 ms streaming.
# VOICE_ASR_ENGINE=conformer
# VOICE_CONFORMER_CHUNK=16
# VOICE_TTS_ENGINE=kokoro

# --- noise suppression (Module 5) ---
# none | spectral (from scratch, default) | gtcrn | dtln
# VOICE_DENOISE_ENGINE=gtcrn
# who consumes the cleaned stream: vad (default) | both
# VOICE_DENOISE_TARGET=both
# gain floor in dB — how hard a noise-only band may be attenuated
# VOICE_DENOISE_ATTEN_DB=18
